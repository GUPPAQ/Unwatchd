{
  "version": 2,
  "builds": [
    {
      "src": "api/letterboxd.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/letterboxd",
      "dest": "/api/letterboxd.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
